htmlcov/
.topo/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.tally
.hypothesis/
.pytest_cache/
cover/

# Translation files
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version.
#   But we can keep it tracked.

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of microservices, you may want to ignore it.
#Pipfile.lock

# poetry
#   poetry.lock is usually committed, but can be ignored for libraries.
#poetry.lock

# pdm
#   pdm.lock is usually committed, but can be ignored for libraries.
#pdm.lock

# PEP 582; used by e.g. github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# VS Code / Cursor
.vscode/

# IDEs
.idea/

# OS-specific
.DS_Store
Thumbs.db

# Project-specific video/asset caches
*.mp4
*.webm
*.task
demo_squat_landmarks.json

# Local data folder — inputs, outputs, models. Never commit.
data/

# Runtime artifacts — regenerable, never commit.
cache/
logs/
outputs/
models/

